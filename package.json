{
  "name": "mini-teleparty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PariParty: private two-person Netflix watch-together Chrome extension (MV3, WebRTC, Supabase Realtime)",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",

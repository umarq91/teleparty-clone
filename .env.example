# Public values only. NEVER put the Supabase service_role key here.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional TURN server for restrictive networks .
# Free options: self-hosted coturn, or a free-tier provider.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Optional: free GIPHY API key (developers.giphy.com) for GIF/sticker search.
VITE_GIPHY_API_KEY=

{
  "manifest_version": 3,
  "name": "PariParty",
  "version": "0.1.0",
  "description": "PariParty: watch Netflix or YouTube with your favourite human. Synced playback, a private video call, stickers and general silliness.",
  "minimum_chrome_version": "111",
  "action": {
    "default_popup": "popup.html",
    "default_title": "PariParty 🎉",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage"],
  "host_permissions": ["https://www.netflix.com/*", "https://www.youtube.com/*", "https://api.giphy.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
